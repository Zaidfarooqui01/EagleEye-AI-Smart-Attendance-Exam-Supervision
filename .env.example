# Eagle Eye Environment Configuration
# Copy this file to .env and update the values for your environment

# Flask Configuration
FLASK_APP=app.dashboard
FLASK_ENV=production
PYTHONUNBUFFERED=1

# Security - IMPORTANT: Change this to a strong random string in production
EAGLE_EYE_SECRET=your-super-secret-key-change-this-in-production

# Camera Configuration
CAMERA_INDEX=0

# Database
# SQLite is used by default. To use PostgreSQL, update app/config.py
DATABASE_URL=sqlite:///./data/eagle_eye.db

# Face Recognition Settings
FACE_TOLERANCE=0.6
FACE_DETECTION_MODEL=hog

# Eye Detection Settings (Blink Detection)
EYE_AR_THRESH=0.25

# Violation Detection Settings
VIOLATION_SCREENSHOT_COOLDOWN=2.0
SNAPSHOT_ON_SEVERITY=high

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/eagleeye.log

# Web Server Configuration
# For development use the default Flask server
# For production, use Gunicorn (configured in Dockerfile.prod)
WORKERS=4
TIMEOUT=120

# Optional: For HTTPS/SSL
# CERT_FILE=/etc/ssl/certs/certificate.crt
# KEY_FILE=/etc/ssl/private/key.key
